---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  id?: string;
}

const { eyebrow, title, description, id } = Astro.props;
---

<section id={id} class="section">
  <div class="section-copy">
    {eyebrow && <p class="section-eyebrow">{eyebrow}</p>}
    <h2>{title}</h2>
    {description && <p class="section-description">{description}</p>}
  </div>
  <slot />
</section>
